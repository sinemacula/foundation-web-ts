{
    "name": "@sinemacula/web-core",
    "version": "0.0.0",
    "description": "Framework-agnostic kernel shared by every Sine Macula frontend: configuration, HTTP, routing, modules, i18n and storage.",
    "license": "Apache-2.0",
    "author": "Ben Carey <bdmc@sinemacula.co.uk>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sinemacula/web-core-ts.git"
    },
    "homepage": "https://github.com/sinemacula/web-core-ts#readme",
    "bugs": {
        "url": "https://github.com/sinemacula/web-core-ts/issues"
    },
    "keywords": ["sine macula", "vue", "kernel", "frontend", "framework", "typescript", "modular"],
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "packageManager": "npm@11.11.0",
    "exports": {
        "./eslint": "./eslint/index.js",
        "./app/create-web-core-app": {
            "types": "./dist/app/create-web-core-app.d.ts",
            "import": "./dist/app/create-web-core-app.js"
        },
        "./app/services": {
            "types": "./dist/app/services.d.ts",
            "import": "./dist/app/services.js"
        },
        "./composables/use-focus-trap": {
            "types": "./dist/composables/use-focus-trap.d.ts",
            "import": "./dist/composables/use-focus-trap.js"
        },
        "./config/web-environment": {
            "types": "./dist/config/web-environment.d.ts",
            "import": "./dist/config/web-environment.js"
        },
        "./i18n/application-i18n": {
            "types": "./dist/i18n/application-i18n.d.ts",
            "import": "./dist/i18n/application-i18n.js"
        },
        "./module/module": {
            "types": "./dist/module/module.d.ts",
            "import": "./dist/module/module.js"
        },
        "./notifications/confirm-service": {
            "types": "./dist/notifications/confirm-service.d.ts",
            "import": "./dist/notifications/confirm-service.js"
        },
        "./notifications/toast-service": {
            "types": "./dist/notifications/toast-service.d.ts",
            "import": "./dist/notifications/toast-service.js"
        },
        "./query/use-list-query": {
            "types": "./dist/query/use-list-query.d.ts",
            "import": "./dist/query/use-list-query.js"
        },
        "./query/use-resource": {
            "types": "./dist/query/use-resource.d.ts",
            "import": "./dist/query/use-resource.js"
        },
        "./router/navigation-progress": {
            "types": "./dist/router/navigation-progress.d.ts",
            "import": "./dist/router/navigation-progress.js"
        },
        "./router/redirect-loop-error": {
            "types": "./dist/router/redirect-loop-error.d.ts",
            "import": "./dist/router/redirect-loop-error.js"
        },
        "./session/authorization": {
            "types": "./dist/session/authorization.d.ts",
            "import": "./dist/session/authorization.js"
        },
        "./session/create-session-module": {
            "types": "./dist/session/create-session-module.d.ts",
            "import": "./dist/session/create-session-module.js"
        },
        "./session/middleware": {
            "types": "./dist/session/middleware.d.ts",
            "import": "./dist/session/middleware.js"
        },
        "./session/redirect": {
            "types": "./dist/session/redirect.d.ts",
            "import": "./dist/session/redirect.js"
        },
        "./session/session-context": {
            "types": "./dist/session/session-context.d.ts",
            "import": "./dist/session/session-context.js"
        },
        "./session/session-realtime": {
            "types": "./dist/session/session-realtime.d.ts",
            "import": "./dist/session/session-realtime.js"
        },
        "./session/session-refresh-coordinator": {
            "types": "./dist/session/session-refresh-coordinator.d.ts",
            "import": "./dist/session/session-refresh-coordinator.js"
        },
        "./session/session-store": {
            "types": "./dist/session/session-store.d.ts",
            "import": "./dist/session/session-store.js"
        },
        "./storage/strict-web-storage": {
            "types": "./dist/storage/strict-web-storage.d.ts",
            "import": "./dist/storage/strict-web-storage.js"
        },
        "./storage/web-locks-session-lock": {
            "types": "./dist/storage/web-locks-session-lock.d.ts",
            "import": "./dist/storage/web-locks-session-lock.js"
        },
        "./theme/color-scheme-boot": {
            "types": "./dist/theme/color-scheme-boot.d.ts",
            "import": "./dist/theme/color-scheme-boot.js"
        }
    },
    "files": [
        "dist",
        "eslint",
        "!eslint/**/__tests__/**",
        "!eslint/**/*.test.js",
        "!eslint/vitest.config.mjs",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "workspaces": ["playground"],
    "scripts": {
        "dev": "npm run dev --workspace playground",
        "build": "npm run build --workspace playground",
        "build:dist": "node scripts/build.mjs",
        "preview": "npm run preview --workspace playground",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:mutation": "stryker run",
        "test:mutation:eslint": "stryker run stryker.eslint.config.json",
        "mutation:scope": "node scripts/mutation-scope.mjs",
        "test:scripts": "vitest run --config scripts/vitest.config.mjs",
        "check": "qlty check",
        "fmt": "qlty fmt",
        "smells": "qlty smells",
        "deadcode": "knip",
        "lint:structure": "eslint --no-config-lookup --no-inline-config --config eslint.structure.mjs src playground/src e2e",
        "test:eslint": "vitest run --config eslint/vitest.config.mjs",
        "check:pkg": "rm -rf .pack && mkdir -p .pack && npm pack --pack-destination .pack --silent && publint .pack/*.tgz && attw .pack/*.tgz --profile esm-only --exclude-entrypoints ./eslint",
        "test:consumer": "node scripts/consumer-smoke.mjs",
        "test:e2e": "playwright test --project=chromium --project=mobile-chromium",
        "test:e2e:engines": "playwright test --project=firefox --project=webkit --project=mobile-webkit",
        "test:e2e:ui": "playwright test --ui",
        "size": "npm run size --workspace playground",
        "prepare": "node scripts/build.mjs"
    },
    "peerDependencies": {
        "@typescript-eslint/utils": "^8",
        "eslint": ">=9",
        "pinia": ">=3",
        "typescript-eslint": "^8",
        "vue": ">=3.5",
        "vue-eslint-parser": ">=10",
        "vue-i18n": ">=11",
        "vue-router": ">=4"
    },
    "peerDependenciesMeta": {
        "@typescript-eslint/utils": {
            "optional": true
        },
        "eslint": {
            "optional": true
        },
        "typescript-eslint": {
            "optional": true
        },
        "vue-eslint-parser": {
            "optional": true
        }
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@axe-core/playwright": "^4.11.3",
        "@playwright/test": "^1.60.0",
        "@sinemacula/coding-standards": "^1.30.1",
        "@size-limit/file": "^12.1.0",
        "@stryker-mutator/core": "^10.1.1",
        "@stryker-mutator/vitest-runner": "^10.1.1",
        "@types/node": "^25.9.3",
        "@typescript-eslint/rule-tester": "^8.73.0",
        "@typescript-eslint/utils": "^8.73.0",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vitest/coverage-v8": "^4.1.12",
        "eslint": "^10.7.0",
        "happy-dom": "^21.0.4",
        "knip": "^6.16.1",
        "mkdist": "^2.4.1",
        "publint": "^0.3.21",
        "size-limit": "^12.1.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.73.0",
        "vite": "^8.0.16",
        "vitest": "^4.1.12",
        "vue-eslint-parser": "^10.0.0",
        "vue-tsc": "^3.3.4"
    },
    "overrides": {
        "brace-expansion": "^5.0.7",
        "fast-uri": "^3.1.3",
        "qs": "^6.17.1",
        "@stryker-mutator/core": {
            "minimatch": "^11.0.9"
        }
    },
    "dependencies": {
        "@sinemacula/foundation": "github:sinemacula/foundation-ts#master"
    }
}
