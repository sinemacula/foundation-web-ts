# Local development only; copy to `.env`. Deployed builds read the unprefixed
# keys from `runtime-env.json` (scripts/generate-runtime-env.mjs), so keep the
# two lists in sync.

VITE_APP_ENV=local
VITE_API_URL=http://localhost:8000
VITE_APP_URL=http://localhost:5173
VITE_DEFAULT_LOCALE=en-US
VITE_ENABLED_LOCALES=["en-US","fr-FR"]
VITE_FEATURE_FLAGS={"new-dashboard":true,"checkout-flow":"b"}
